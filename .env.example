# MOCK-TUA env (copy to .env — do not commit secrets)

MOCK_TUA_HOST=0.0.0.0
MOCK_TUA_PORT=8799

# Live MAC services
HEADROOM_BASE=http://host.docker.internal:8787/v1
# Or when running API on host: http://127.0.0.1:8787/v1
COMFY_MAC_URL=http://host.docker.internal:8188
COMFY_GPU_URL=http://<gpu-host-ip>:8188

# Headroom / LiteLLM master key (your own LLM gateway/proxy)
LITELLM_MASTER_KEY=
LLM_MODEL=manager-auto
# Cloud options for S0 script expansion when MOCK_TUA_QQQ=QQQ1 (paid cloud) --
# each requires its own provider API key set on your LLM gateway:
# LLM_MODEL=manager-claude-paid   # Anthropic/Claude — needs ANTHROPIC_API_KEY
# LLM_MODEL=manager-codex-paid    # OpenAI — needs OPENAI_API_KEY
# LLM_MODEL=manager-gemini-paid   # Gemini — needs GEMINI_API_KEY
# LLM_MODEL=manager-hf-paid       # Hugging Face Inference — needs HF_TOKEN

# Work roots
WORK_ROOT=/path/to/your/shared/storage/work/story-anim
# Fallback when shared storage is unavailable
WORK_FALLBACK=./work

# Modes
MOCK_TUA_QQQ=QQQ0
MOCK_TUA_DRY_RUN=1
MOCK_TUA_HF_LIVE=0
MOCK_TUA_LIVE_STILL=0

# Optional HF (only if MOCK_TUA_HF_LIVE=1)
HF_TOKEN=
