# MOCK-TUA env (copy to .env — do not commit secrets)

MOCK_TUA_HOST=0.0.0.0
MOCK_TUA_PORT=8799

# Live desk-host services
HEADROOM_BASE=http://host.docker.internal:8787/v1
# Or when running API on host: http://127.0.0.1:8787/v1
COMFY_desk-host_URL=http://host.docker.internal:8188
COMFY_gpu-host_URL=http://REDACTED-LAN-IP:8188

# Headroom / LiteLLM master key (from ~/ai-gateway/.env)
LITELLM_MASTER_KEY=
LLM_MODEL=manager-auto
# Cloud options for S0 script expansion when MOCK_TUA_QQQ=QQQ1 (paid cloud):
# LLM_MODEL=manager-claude-paid   # Anthropic/Claude — requires ANTHROPIC_API_KEY in ai-gateway/.env
# LLM_MODEL=manager-codex-paid    # OpenAI — requires OPENAI_API_KEY in ai-gateway/.env
# LLM_MODEL=manager-gemini-paid   # Gemini — requires GEMINI_API_KEY in ai-gateway/.env
# LLM_MODEL=manager-hf-paid       # Hugging Face Inference — requires HF_TOKEN in ai-gateway/.env

# Work roots
WORK_ROOT=/Volumes/ai-data/work/story-anim
# Fallback when NFS unavailable
WORK_FALLBACK=./work

# Modes
MOCK_TUA_QQQ=QQQ0
MOCK_TUA_DRY_RUN=1
MOCK_TUA_HF_LIVE=0
MOCK_TUA_LIVE_STILL=0

# Optional HF (only if MOCK_TUA_HF_LIVE=1)
HF_TOKEN=
