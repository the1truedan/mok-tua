/* Commodore 64 canvas — VIC-II blue + light blue text
   Default skin (aliases: 1980crt, tui-c64-mode-default-1980crt-tui).
   Native spirit: 40-col monospaced, line-oriented prompt.
   True 320×200 framebuffer remains docs mock; this is the ops skin. */

Screen {
    background: #40318d;
    color: #a5a0ff;
    layout: vertical;
}

#chrome {
    dock: top;
    height: auto;
    background: #40318d;
    color: #ffffff;
    padding: 0 1;
    text-style: bold;
}

#menu {
    dock: top;
    height: auto;
    background: #40318d;
    color: #d5df7c;
    padding: 0 1;
}

/* Inverse VIC-II boot: light-blue paper + deep ink so block logo stays legible.
   (Normal deck stays classic light-on-dark below.) */
#boot {
    height: 1fr;
    background: #a5a0ff;
    color: #1a1448;
    padding: 1 2;
    text-style: bold;
    content-align: center middle;
    text-align: center;
    overflow-x: hidden;
    overflow-y: auto;
}

#main-panes {
    height: 1fr;
    layout: horizontal;
}

#left-pane {
    width: 2fr;
    height: 1fr;
}

#right-pane {
    width: 1fr;
    height: 1fr;
    min-width: 28;
    border-left: solid #6c5eb5;
    background: #40318d;
}

#log {
    height: 1fr;
    background: #40318d;
    color: #a5a0ff;
    border: solid #6c5eb5;
    padding: 0 1;
    scrollbar-background: #40318d;
    scrollbar-color: #7869c4;
}

#stats {
    height: 1fr;
    background: #40318d;
    color: #d5df7c;
    padding: 0 1;
    overflow-y: auto;
}

#prompt-row {
    dock: bottom;
    height: auto;
    background: #40318d;
    padding: 0 1 1 1;
}

#ready {
    color: #ffffff;
    width: auto;
}

Input {
    background: #40318d;
    color: #ffffff;
    border: none;
    padding: 0 1;
    width: 1fr;
}

Input:focus {
    background: #40318d;
    border: none;
}
