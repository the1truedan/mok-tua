/* White / light gray text on black (alias: paper) */

Screen {
    background: #000000;
    color: #e0e0e0;
    layout: vertical;
}

#chrome {
    dock: top;
    height: auto;
    background: #111111;
    color: #ffffff;
    padding: 0 1;
    text-style: bold;
}

#menu {
    dock: top;
    height: auto;
    background: #000000;
    color: #b0b0b0;
    padding: 0 1;
}

/* Inverse paper boot: white field + black ink for block logo */
#boot {
    height: 1fr;
    background: #e8e8e8;
    color: #000000;
    padding: 1 2;
    text-style: bold;
    content-align: center middle;
    text-align: center;
    overflow-x: hidden;
    overflow-y: auto;
}

#main-panes {
    height: 1fr;
    layout: horizontal;
}

#left-pane {
    width: 2fr;
    height: 1fr;
}

#right-pane {
    width: 1fr;
    height: 1fr;
    min-width: 28;
    border-left: solid #555555;
    background: #000000;
}

#log {
    height: 1fr;
    background: #000000;
    color: #e0e0e0;
    border: solid #555555;
    padding: 0 1;
    scrollbar-background: #000000;
    scrollbar-color: #888888;
}

#stats {
    height: 1fr;
    background: #000000;
    color: #cccccc;
    padding: 0 1;
    overflow-y: auto;
}

#prompt-row {
    dock: bottom;
    height: auto;
    background: #111111;
    padding: 0 1 1 1;
}

#ready {
    color: #ffffff;
    width: auto;
}

Input {
    background: #000000;
    color: #ffffff;
    border: none;
    padding: 0 1;
    width: 1fr;
}

Input:focus {
    background: #1a1a1a;
    border: none;
}
