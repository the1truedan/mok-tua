/* Modern ops TUI — navy conductor chrome (matches mok-up frames) */

Screen {
    background: #0b1220;
    color: #d7e0f2;
    layout: vertical;
}

#chrome {
    dock: top;
    height: auto;
    background: #121a2b;
    color: #e8eefc;
    padding: 0 1;
    text-style: bold;
    border-bottom: solid #2a3a5c;
}

#menu {
    dock: top;
    height: auto;
    background: #0f1729;
    color: #9fb4d9;
    padding: 0 1;
}

/* Inverse navy boot for high-contrast block logo */
#boot {
    height: 1fr;
    background: #d7e0f2;
    color: #0b1220;
    padding: 1 2;
    text-style: bold;
    content-align: center middle;
    text-align: center;
    overflow-x: hidden;
    overflow-y: auto;
}

#main-panes {
    height: 1fr;
    layout: horizontal;
}

#left-pane {
    width: 2fr;
    height: 1fr;
}

#right-pane {
    width: 1fr;
    height: 1fr;
    min-width: 28;
    border-left: solid #2a3a5c;
    background: #0b1220;
}

#log {
    height: 1fr;
    background: #0b1220;
    color: #c9d4ea;
    border: solid #2a3a5c;
    padding: 0 1;
    scrollbar-background: #0b1220;
    scrollbar-color: #3d5a8a;
}

#stats {
    height: 1fr;
    background: #0b1220;
    color: #9fb4d9;
    padding: 0 1;
    overflow-y: auto;
}

#prompt-row {
    dock: bottom;
    height: auto;
    background: #121a2b;
    padding: 0 1 1 1;
    border-top: solid #2a3a5c;
}

#ready {
    color: #7ddea8;
    width: auto;
}

Input {
    background: #0b1220;
    color: #e8eefc;
    border: tall #2a3a5c;
    padding: 0 1;
    width: 1fr;
}

Input:focus {
    border: tall #5b8def;
}
