    "description": "Recommended multi-launcher director chain for bleeding-edge local demo",
    "stages": [
      {"id": "S0", "tool": "mok_tua|directors_console", "action": "sides → shots / CPE prompts"},
      {"id": "S1", "tool": "sm_comfy|qwen_edit", "action": "storyboard stills multi-angle next-scene"},
