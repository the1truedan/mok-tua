      {"id": "S3", "tool": "wan2gp|sm_comfy_wan|framepack", "action": "I2V / animate / long form"},
      {"id": "S3b", "tool": "dreamtalk|wan_infinitetalk", "action": "lipsync / talking avatar"},
      {"id": "S3c", "tool": "freemocap", "action": "body track → pose maps for retarget"},
      {"id": "S5", "tool": "mok_tua_stitch", "action": "ffmpeg concat + audit receipts"}
    ]
  },
