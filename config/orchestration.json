{
  "version": 1,
  "updated": "2026-07-24",
  "description": "MOCK-TUA hybrid: live MAC Headroom + SM Comfy; video \u2192 GPU; cloud overflow estimated only by default.",
  "model_pool": {
    "MAC": "/Volumes/ai-data/models",
    "GPU": "/mnt/ai-data/models",
    "STORAGE": "/mnt/ai-data/models"
  },
  "endpoints": {
    "mac": {
      "host": "mac",
      "label": "Mac SM ComfyUI (live)",
      "base_url": "http://127.0.0.1:8188",
      "role": "image",
      "mode": "live"
    },
    "gpu": {
      "host": "gpu",
      "label": "GPU ComfyUI (container or host runtime)",
      "base_url": "http://<gpu-host-ip>:8188",
      "role": "video",
      "mode": "remote"
    },
    "headroom": {
      "host": "mac",
      "label": "Live Headroom / LiteLLM path",
      "base_url": "http://localhost:8787/v1",
      "role": "llm",
      "mode": "live"
    },
    "mock_cloud": {
      "host": "stub",
      "label": "Cloud overflow estimate stub (live path: manager-openrouter-free on Headroom/GPU LiteLLM)",
      "base_url": "http://127.0.0.1:8899",
      "role": "cloud",
      "mode": "stub",
      "live_model": "manager-openrouter-free",
      "note": "NEW LAW: GPU may use cloud compute for mock-tua overflow; never PHI auto-cloud"
    },
    "gpu_litellm": {
      "host": "gpu",
      "label": "GPU LiteLLM worker+cloud",
      "base_url": "http://<gpu-host-ip>:4000/v1",
      "role": "llm_worker_cloud",
      "mode": "live"
    }
  },
  "routing": {
    "script_to_shots": "headroom",
    "image-gen": "mac",
    "character-sheet": "mac",
    "storyboard-panel": "mac",
    "video-gen": "gpu",
    "i2v": "gpu",
    "talking-avatar": "gpu",
    "cloud-overflow": "mock_cloud"
  },
  "outputs": {
    "work_root_MAC": "/Volumes/ai-data/work/story-anim",
    "work_root_GPU": "/mnt/ai-data/work/story-anim",
    "local_fallback": "./work"
  },
  "still_defaults": {
    "checkpoint": "DreamShaper_8_pruned.safetensors",
    "width": 768,
    "height": 768,
    "steps": 20,
    "cfg": 7.0
  },
  "mvp_chain": [
    "script_to_shots",
    "character_sheet",
    "storyboard_panels",
    "i2v_or_wan_animate",
    "resume_segment",
    "stitch"
  ],
  "llm": {
    "model": "manager-auto",
    "max_tokens": 2048,
    "temperature": 0.4
  }
}
